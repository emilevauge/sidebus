<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Sidebus is not sandboxed: CGVirtualDisplay is a private API, so distribution happens
	  outside the App Store anyway.

	  Event injection and screen capture are not granted by entitlement but by TCC
	  permission, given by the user.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Hardened runtime: required for notarization. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<false/>
</dict>
</plist>
