<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The Mac connects to the tablet, so we listen on the local network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- On a phone, the Mac completes contact names when placing a call. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sidebus">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="userLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density"
            android:theme="@style/Theme.Sidebus">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Read over adb by the Mac. DUMP is held by the adb shell and by no app. -->
        <provider
            android:name=".phone.ContactsProvider"
            android:authorities="app.sidebus.contacts"
            android:exported="true"
            android:readPermission="android.permission.DUMP"
            android:writePermission="android.permission.DUMP" />

        <activity
            android:name=".phone.ContactsAccessActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    </application>

</manifest>
